{
  "expo": {
    "name": "GUKAK STUDIO",
    "slug": "gukak-studio",
    "scheme": "gukakstudio",
    "orientation": "landscape",
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow GUKAK STUDIO to record short prototype performances.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.gukakstudio.prototype"
    },
    "ios": {
      "bundleIdentifier": "com.gukakstudio.prototype"
    }
  }
}
